{
  "description": "Record every prompt, command and tool call Codex runs as a markdown ledger.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /absolute/path/to/session-ledger/bin/session-ledger.js hook --harness codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node /absolute/path/to/session-ledger/bin/session-ledger.js hook --harness codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node /absolute/path/to/session-ledger/bin/session-ledger.js hook --harness codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /absolute/path/to/session-ledger/bin/session-ledger.js hook --harness codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
