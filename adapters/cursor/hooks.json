{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "node /absolute/path/to/session-ledger/bin/session-ledger.js hook --harness cursor"
      }
    ],
    "preToolUse": [
      {
        "command": "node /absolute/path/to/session-ledger/bin/session-ledger.js hook --harness cursor"
      }
    ],
    "postToolUse": [
      {
        "command": "node /absolute/path/to/session-ledger/bin/session-ledger.js hook --harness cursor"
      }
    ],
    "postToolUseFailure": [
      {
        "command": "node /absolute/path/to/session-ledger/bin/session-ledger.js hook --harness cursor"
      }
    ]
  }
}
